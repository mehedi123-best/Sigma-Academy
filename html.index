<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="সাফল্য কোচিং সেন্টার — স্কুল, কলেজ ও ভর্তি পরীক্ষার প্রস্তুতি।">
  <title>সাফল্য কোচিং সেন্টার</title>

  <style>
    :root {
      --primary: #155eef;
      --dark: #14213d;
      --light: #f5f8ff;
      --text: #344054;
      --white: #fff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Noto Sans Bengali", "Hind Siliguri", Arial, sans-serif;
      color: var(--text);
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1100px, 92%);
      margin: auto;
    }

    header {
      background: var(--white);
      box-shadow: 0 2px 14px #14213d12;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav {
      min-height: 72px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      color: var(--primary);
      font-size: 1.35rem;
      font-weight: 800;
    }

    .nav-links {
      display: flex;
      gap: 24px;
      list-style: none;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    .button {
      display: inline-block;
      background: var(--primary);
      color: var(--white);
      padding: 11px 20px;
      border-radius: 8px;
      font-weight: 700;
      border: 0;
      cursor: pointer;
    }

    .button:hover {
      background: #0b4bd4;
    }

    .hero {
      background: linear-gradient(120deg, #eef4ff, #fff);
      padding: 78px 0;
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 40px;
    }

    .hero h1 {
      color: var(--dark);
      font-size: clamp(2rem, 5vw, 3.4rem);
      line-height: 1.25;
      margin-bottom: 18px;
    }

    .hero p {
      font-size: 1.1rem;
      margin-bottom: 24px;
    }

    .hero-card {
      background: var(--white);
      padding: 30px;
      border-radius: 18px;
      box-shadow: 0 12px 35px #14213d14;
    }

    .hero-card h2 {
      color: var(--dark);
      margin-bottom: 12px;
    }

    section {
      padding: 68px 0;
    }

    .section-title {
      text-align: center;
      color: var(--dark);
      font-size: 2rem;
      margin-bottom: 12px;
    }

    .section-intro {
      max-width: 650px;
      text-align: center;
      margin: 0 auto 36px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: var(--white);
      border: 1px solid #e6eaf2;
      padding: 24px;
      border-radius: 14px;
      box-shadow: 0 5px 18px #14213d08;
    }

    .card h3 {
      color: var(--dark);
      margin-bottom: 8px;
    }

    .courses {
      background: var(--light);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      text-align: center;
    }

    .stat {
      padding: 24px;
      background: var(--white);
      border-radius: 14px;
    }

    .stat strong {
      display: block;
      color: var(--primary);
      font-size: 2rem;
    }

    .contact-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .contact-form {
      display: grid;
      gap: 14px;
    }

    input, select, textarea {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #d0d5dd;
      border-radius: 8px;
      font: inherit;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    footer {
      background: var(--dark);
      color: var(--white);
      padding: 24px 0;
      text-align: center;
    }

    @media (max-width: 760px) {
      .nav-links {
        display: none;
      }

      .hero-content,
      .contact-layout {
        grid-template-columns: 1fr;
      }

      .grid,
      .stats {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 54px 0;
      }

      section {
        padding: 50px 0;
      }
    }
  </style>
</head>

<body>
  <header>
    <nav class="container">
      <a class="logo" href="#">সাফল্য কোচিং</a>

      <ul class="nav-links">
        <li><a href="#about">আমাদের সম্পর্কে</a></li>
        <li><a href="#courses">কোর্স</a></li>
        <li><a href="#teachers">শিক্ষক</a></li>
        <li><a href="#contact">যোগাযোগ</a></li>
      </ul>

      <a class="button" href="#contact">ভর্তি হতে চাই</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-content">
        <div>
          <h1>সঠিক প্রস্তুতিতে<br>সাফল্য হবে নিশ্চিত</h1>
          <p>
            অভিজ্ঞ শিক্ষকের যত্নে স্কুল, কলেজ ও ভর্তি পরীক্ষার
            মানসম্মত প্রস্তুতি নাও।
          </p>
          <a class="button" href="#courses">আমাদের কোর্স দেখুন</a>
        </div>

        <div class="hero-card">
          <h2>নতুন ব্যাচে ভর্তি চলছে</h2>
          <p>সীমিত আসনে ভর্তি চলছে। বিস্তারিত জানতে আজই যোগাযোগ করো।</p>
          <p style="margin-top: 14px;"><strong>ফোন:</strong> 01XXXXXXXXX</p>
          <p><strong>ঠিকানা:</strong> তোমার এলাকার নাম, বাংলাদেশ</p>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="container">
        <h2 class="section-title">আমাদের সম্পর্কে</h2>
        <p class="section-intro">
          আমরা শিক্ষার্থীদের বুঝে শেখা, নিয়মিত অনুশীলন এবং পরীক্ষায় ভালো
          ফল করার জন্য সহায়তা করি। প্রতিটি শিক্ষার্থীর অগ্রগতিতে আমরা নজর রাখি।
        </p>

        <div class="stats">
          <div class="stat"><strong>৫০০+</strong>শিক্ষার্থী</div>
          <div class="stat"><strong>১০+</strong>অভিজ্ঞ শিক্ষক</div>
          <div class="stat"><strong>৯৫%</strong>সন্তুষ্টির হার</div>
        </div>
      </div>
    </section>

    <section class="courses" id="courses">
      <div class="container">
        <h2 class="section-title">আমাদের কোর্স</h2>
        <p class="section-intro">তোমার প্রয়োজন অনুযায়ী কোর্স বেছে নাও।</p>

        <div class="grid">
          <article class="card">
            <h3>স্কুল একাডেমিক</h3>
            <p>৬ষ্ঠ–১০ম শ্রেণির বিষয়ভিত্তিক ক্লাস, পরীক্ষা ও গাইডলাইন।</p>
          </article>

          <article class="card">
            <h3>এইচএসসি প্রস্তুতি</h3>
            <p>একাদশ ও দ্বাদশ শ্রেণির পাঠ্যসূচি অনুযায়ী নিয়মিত প্রস্তুতি।</p>
          </article>

          <article class="card">
            <h3>ভর্তি পরীক্ষা</h3>
            <p>বিশ্ববিদ্যালয় ও অন্যান্য ভর্তি পরীক্ষার জন্য বিশেষ প্রস্তুতি।</p>
          </article>
        </div>
      </div>
    </section>

    <section id="teachers">
      <div class="container">
        <h2 class="section-title">আমাদের শিক্ষক</h2>
        <p class="section-intro">অভিজ্ঞ ও যত্নশীল শিক্ষকদের সঙ্গে পরিচিত হও।</p>

        <div class="grid">
          <article class="card">
            <h3>মো. শিক্ষকের নাম</h3>
            <p>গণিত শিক্ষক · ৮ বছরের অভিজ্ঞতা</p>
          </article>

          <article class="card">
            <h3>শিক্ষিকার নাম</h3>
            <p>ইংরেজি শিক্ষক · ৬ বছরের অভিজ্ঞতা</p>
          </article>

          <article class="card">
            <h3>শিক্ষকের নাম</h3>
            <p>বিজ্ঞান শিক্ষক · ১০ বছরের অভিজ্ঞতা</p>
          </article>
        </div>
      </div>
    </section>

    <section class="courses">
      <div class="container">
        <h2 class="section-title">শিক্ষার্থীদের মতামত</h2>
        <div class="grid">
          <blockquote class="card">
            “এখানে নিয়মিত পরীক্ষা হয়, তাই পড়া অনেক ভালোভাবে প্রস্তুত করতে পেরেছি।”
            <h3 style="margin-top: 12px;">— একজন শিক্ষার্থী</h3>
          </blockquote>

          <blockquote class="card">
            “শিক্ষকেরা কঠিন বিষয়গুলো সহজ করে বুঝিয়ে দেন।”
            <h3 style="margin-top: 12px;">— একজন অভিভাবক</h3>
          </blockquote>

          <blockquote class="card">
            “ছোট ব্যাচে পড়ানোর কারণে সবাই আলাদা করে সাহায্য পায়।”
            <h3 style="margin-top: 12px;">— একজন শিক্ষার্থী</h3>
          </blockquote>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <h2 class="section-title">যোগাযোগ ও ভর্তি</h2>
        <p class="section-intro">ফর্ম পূরণ করো, আমরা তোমার সঙ্গে যোগাযোগ করব।</p>

        <div class="contact-layout">
          <div class="card">
            <h3>যোগাযোগের তথ্য</h3>
            <p><strong>ফোন:</strong> 01XXXXXXXXX</p>
            <p><strong>ইমেইল:</strong> info@example.com</p>
            <p><strong>ঠিকানা:</strong> তোমার কোচিংয়ের পূর্ণ ঠিকানা</p>
            <p><strong>সময়:</strong> প্রতিদিন বিকেল ৩টা–রাত ৮টা</p>
          </div>

          <form class="card contact-form" onsubmit="submitForm(event)">
            <input type="text" id="name" placeholder="তোমার নাম" required>
            <input type="tel" id="phone" placeholder="মোবাইল নম্বর" required>

            <select id="course" required>
              <option value="">কোর্স নির্বাচন করো</option>
              <option>স্কুল একাডেমিক</option>
              <option>এইচএসসি প্রস্তুতি</option>
              <option>ভর্তি পরীক্ষা</option>
            </select>

            <textarea id="message" placeholder="কিছু জানতে চাইলে লিখো"></textarea>
            <button class="button" type="submit">তথ্য পাঠাও</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>© <span id="year"></span> সাফল্য কোচিং সেন্টার। সর্বস্বত্ব সংরক্ষিত।</p>
    </div>
  </footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    function submitForm(event) {
      event.preventDefault();

      const name = document.getElementById("name").value.trim();
      const phone = document.getElementById("phone").value.trim();
      const course = document.getElementById("course").value;

      alert(
        `ধন্যবাদ ${name}! তোমার ${course} কোর্সের আবেদন পেয়েছি। ` +
        `আমরা ${phone} নম্বরে যোগাযোগ করব।`
      );

      event.target.reset();
    }
  </script>
</body>
</html>